<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================== -->
    <!-- 1. ĐỊNH DANH: dự án này là ai                              -->
    <!-- ========================================================== -->
    <groupId>io.github.codeser</groupId>
    <artifactId>lookbefore-change-impact-analyzer</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>   <!-- POM cha: chỉ quản lý, không tạo jar -->

    <name>Codeser Lookbefore</name>
    <description>Phân tích tác động của một thay đổi code trước khi merge.</description>

    <!-- ========================================================== -->
    <!-- 2. MODULE CON: build theo thứ tự phụ thuộc                 -->
    <!-- ========================================================== -->
    <modules>
        <module>lookbefore-analysis-core</module>
        <module>lookbefore-cli-application</module>
    </modules>

    <!-- ========================================================== -->
    <!-- 3. THUỘC TÍNH: mọi con số nằm ở một chỗ                    -->
    <!-- ========================================================== -->
    <properties>
        <!-- Phiên bản Java: compiler tự đọc property này, enforcer dùng lại -->
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Mã hóa ký tự cho mã nguồn và báo cáo -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Thư viện -->
        <picocli.version>4.7.7</picocli.version>
        <jgit.version>7.8.0.202609011348-r</jgit.version>
        <javaparser.version>3.28.2</javaparser.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <jackson.version>3.2.3</jackson.version>
        <slf4j.version>2.0.18</slf4j.version>
        <junit.version>6.1.3</junit.version>

        <!-- Plugin -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    </properties>

    <!-- ========================================================== -->
    <!-- 4. QUẢN LÝ PHIÊN BẢN THƯ VIỆN                              -->
    <!--    Chỉ quy định phiên bản; module con tự khai báo thứ mình -->
    <!--    cần trong <dependencies>, không ghi phiên bản.          -->
    <!-- ========================================================== -->
    <dependencyManagement>
        <dependencies>
            <!-- Module nội bộ -->
            <dependency>
                <groupId>io.github.codeser</groupId>
                <artifactId>lookbefore-analysis-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Thư viện đơn lẻ -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>

            <!-- Bộ thư viện dùng BOM: một phiên bản cho cả họ -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-bom</artifactId>
                <version>${slf4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- ====================================================== -->
        <!-- 5. QUẢN LÝ PLUGIN: phiên bản và cấu hình chung          -->
        <!--    Chưa chạy gì; module nào khai báo thì mới chạy.     -->
        <!-- ====================================================== -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <configuration>
                        <!-- Sửa cảnh báo mã hóa khi điền phiên bản vào file .properties -->
                        <propertiesEncoding>UTF-8</propertiesEncoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <!-- release lấy từ property maven.compiler.release -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- ====================================================== -->
        <!-- 6. PLUGIN CHẠY CHO MỌI MODULE                          -->
        <!--    Chỉ giữ thứ thật sự cần ở mọi nơi.                  -->
        <!-- ====================================================== -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${maven.compiler.release},)</version>
                                    <message>Codeser Lookbefore cần JDK ${maven.compiler.release} trở lên để build.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>Hãy build bằng ./mvnw thay vì Maven cài sẵn trên máy.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
