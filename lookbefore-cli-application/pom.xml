<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.codeser</groupId>
        <artifactId>lookbefore-change-impact-analyzer</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lookbefore-cli-application</artifactId>
    <packaging>jar</packaging>

    <name>Codeser Lookbefore :: CLI Application</name>
    <description>Ứng dụng dòng lệnh và các adapter cài đặt port của lõi.</description>

    <properties>
        <main.class>io.github.codeser.lookbefore.cli.LookbeforeMain</main.class>
    </properties>

    <dependencies>
        <!-- Lõi của Lookbefore -->
        <dependency>
            <groupId>io.github.codeser</groupId>
            <artifactId>lookbefore-analysis-core</artifactId>
        </dependency>

        <!-- Thư viện cho các adapter và dòng lệnh; phiên bản lấy từ POM cha -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- JGit ghi log qua SLF4J; thư viện này chuyển log đó sang java.util.logging của JDK,
             cũng là nơi System.Logger ghi ra mặc định. Thiếu nó, SLF4J in cảnh báo ra terminal.
             Lưu ý: KHÔNG dùng slf4j-jdk-platform-logging, thư viện đó chuyển log theo chiều ngược lại. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Không đặt <finalName> ở đây: jar thông thường giữ tên mặc định
             lookbefore-cli-application-<phiên bản>.jar. Tên lookbefore.jar do shade đặt bên dưới. -->

        <resources>
            <!-- Chỉ file phiên bản được lọc; prompt và script database giữ nguyên ký tự ${...}. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>lookbefore-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>lookbefore-version.properties</exclude>
                    <exclude>**/.gitkeep</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Tên riêng cho file gộp. Khác tên jar gốc nên jar gốc không bị thay thế,
                                 và shade luôn gộp từ jar gốc chưa gộp, kể cả khi không chạy clean. -->
                            <finalName>lookbefore</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Điểm khởi chạy; báo JVM rằng jar có lớp riêng cho từng phiên bản Java -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <!-- Nối các file META-INF/services trùng tên (driver JDBC, SLF4J...) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Nối các file giấy phép thay vì chỉ giữ một bản -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/LICENSE.txt</resource>
                                </transformer>
                                <!-- Gộp các file NOTICE -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <!-- Chữ ký và module descriptor của jar phụ thuộc không còn hợp lệ trong uber-jar. -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.EC</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Bật test tích hợp (*IT.java) cho module này; cấu hình lấy từ POM cha -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
